{
  "name": "agent-platform-anthropic-pi",
  "version": "0.6.0",
  "private": true,
  "description": "Pi extension package to use Anthropic partner models on Google Gemini Enterprise Agent Platform",
  "keywords": [
    "agent-platform",
    "anthropic",
    "claude",
    "gemini-enterprise",
    "pi-package"
  ],
  "scripts": {
    "format": "npx oxfmt --write package.json extensions/**/*.ts",
    "format:check": "npx oxfmt --check package.json extensions/**/*.ts",
    "prettier:apply": "npm run format",
    "prettier:check": "npm run format:check",
    "lint": "npx oxlint extensions",
    "lint:fix": "npx oxlint --fix extensions",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
