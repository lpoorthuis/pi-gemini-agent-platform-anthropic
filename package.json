{
  "name": "pi-gemini-agent-platform-anthropic",
  "version": "0.8.0",
  "private": true,
  "description": "Pi extension package to use Anthropic partner models on Google Gemini Enterprise Agent Platform",
  "keywords": [
    "agent-platform",
    "anthropic",
    "claude",
    "gemini-enterprise",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "format": "npx oxfmt --write package.json extensions/**/*.ts",
    "format:check": "npx oxfmt --check package.json extensions/**/*.ts",
    "prettier:apply": "npm run format",
    "prettier:check": "npm run format:check",
    "lint": "npx oxlint extensions",
    "lint:fix": "npx oxlint --fix extensions",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2023 --skipLibCheck extensions/agent-platform-anthropic.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
